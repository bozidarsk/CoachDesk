<div class="card border-secondary mb-3" style="margin: 0px 20%">
	<div class="card-header">Login</div>
	<div class="card-body">
		<form asp-area="" asp-controller="Login" asp-action="Submit" method="post">
			<input name="isCoach" value="false" hidden/>
			<label for="emailInput" class="form-label mt-4">Email address</label>
			<input type="email" class="form-control" id="emailInput" name="email" aria-describedby="emailHelp" placeholder="Enter email"/>
			<label for="passwordInput" class="form-label mt-4">Password</label>
			<input type="password" class="form-control" id="passwordInput" name="password" placeholder="Password" autocomplete="off"/>
			<br/>
			<input class="form-check-input" type="checkbox" id="stayLoggedInCheck" name="stayLoggedIn" value="true" checked/>
			<label class="form-check-label" for="stayLoggedInCheck">Stay logged in</label>
			<br/>
			<br/>
			<input type="submit" class="btn btn-primary" value="Log in"></input>
			<br/>
			<br/>
		</form>
		<p style="text-align: center;">You don&apos;t have an account yet? - <a asp-area="" asp-controller="Signup" asp-action="Index">Sign up</a></p>
		<p style="text-align: center;">Want to become a coach? - <a asp-area="" asp-controller="Signup" asp-action="Coach">Sign up as a coach</a></p>
	</div>
</div>
