@model MembershipPlanViewModel

@{
	ViewData["Title"] = "Delete Membership Plan";
}

<div class="row justify-content-center">
	<div class="col-md-8 col-lg-6">
		<h1 class="h3 mb-4">Delete membership plan</h1>

		@if (Model.ActiveSubscribers > 0)
		{
			<div class="alert alert-danger">
				@Model.ActiveSubscribers @(Model.ActiveSubscribers == 1 ? "client holds" : "clients hold") this plan, so it can't be deleted.
			</div>
		}
		else
		{
			<div class="alert alert-warning">Delete this plan? This can't be undone.</div>
		}

		<div class="card mb-4">
			<div class="card-body">
				<dl class="row mb-0">
					<dt class="col-sm-5">Plan name</dt>
					<dd class="col-sm-7">@Model.Name</dd>

					<dt class="col-sm-5">Price</dt>
					<dd class="col-sm-7">@Model.Price.ToString("C")</dd>

					<dt class="col-sm-5">Number of sessions</dt>
					<dd class="col-sm-7">@(Model.Count?.ToString() ?? "Unlimited")</dd>

					<dt class="col-sm-5">Valid for</dt>
					<dd class="col-sm-7 mb-0">@(Model.Duration is int days ? $"{days} days" : "Forever")</dd>
				</dl>
			</div>
		</div>

		<form asp-controller="MembershipPlan" asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
			<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
			@if (Model.ActiveSubscribers == 0)
			{
				<button type="submit" class="btn btn-danger">Delete plan</button>
			}
			<a class="btn btn-outline-secondary" href="@ViewData["ReturnUrl"]">Keep plan</a>
		</form>
	</div>
</div>
