@model MembershipPlanViewModel
@using Microsoft.AspNetCore.Http.Extensions

@{
	ViewData["Title"] = Model.Name;

	var perSession = Model.Count is > 0 ? Model.Price / Model.Count.Value : (decimal?)null;

	var sessionsText = Model.Count is int count
		? (count == 1 ? "1 session" : count + " sessions")
		: "Unlimited sessions"
	;

	var validityText = Model.Duration is int n
		? (n == 1 ? "valid for 1 day" : "valid for " + n + " days")
		: "valid forever"
	;
}

<div class="row justify-content-center">
	<div class="col-lg-8">
		@if (Model.OwnerViewing)
		{
			<nav class="mb-3">
				<a class="text-decoration-none" asp-controller="Coach" asp-action="Dashboard">Back to dashboard</a>
			</nav>
		}
		else if (Model.ClientViewing)
		{
			<nav class="mb-3">
				<a class="text-decoration-none" asp-controller="Client" asp-action="Dashboard">Back to dashboard</a>
			</nav>
		}

		<div class="d-flex flex-wrap align-items-start gap-2 mb-4">
			<div class="me-auto">
				<h1 class="h3 mb-1">@Model.Name
					@if (Model.MembershipStatus != MembershipStatus.Unknown)
					{
						var css = Model.MembershipStatus switch
						{
							MembershipStatus.Active => "bg-success",
							MembershipStatus.Expired or MembershipStatus.OutOfSessions => "bg-light",
							_ => "",
						};

						<span class="badge rounded-pill @css text-dark border">@Model.MembershipStatus.ToString()</span>
					}
				</h1>
				<div class="text-muted">@sessionsText, @validityText</div>
			</div>

			@if (Model.OwnerViewing)
			{
				<div class="d-flex gap-2">
					<a class="btn btn-primary" style="display: flex; align-items: center; justify-content: space-between;" asp-controller="MembershipPlan" asp-action="Edit" asp-route-id="@Model.Id" asp-route-returnUrl="@Context.Request.GetEncodedPathAndQuery()">Edit plan</a>
					<a class="btn btn-outline-danger" asp-controller="MembershipPlan" asp-action="Delete" asp-route-id="@Model.Id" asp-route-returnUrl="@Context.Request.GetEncodedPathAndQuery()">Delete plan</a>
				</div>
			}
			else if (Model.ClientViewing)
			{
				<form asp-controller="Membership" asp-action="Purchase" asp-route-membershipPlanId="@Model.Id" asp-route-returnUrl="@Context.Request.GetEncodedPathAndQuery()" method="post">
					<button class="btn btn-primary" type="submit">Purchase plan</button>
				</form>
			}
		</div>

		@if (Model.ClientViewing && TempData["MembershipPurchaseError"] is string membershipPurchaseError)
		{
			<div class="text-danger">@membershipPurchaseError</div>
		}

		<div class="card">
			<div class="card-header fw-bold">Plan details</div>
			<div class="card-body">
				<dl class="row mb-0">
					<dt class="col-sm-5">Price</dt>
					<dd class="col-sm-7">@Model.Price.ToString("C")</dd>

					<dt class="col-sm-5">Number of sessions</dt>
					<dd class="col-sm-7">@(Model.Count?.ToString() ?? "Unlimited")</dd>

					@if (perSession.HasValue)
					{
						<dt class="col-sm-5">Price per session</dt>
						<dd class="col-sm-7">@perSession.Value.ToString("C")</dd>
					}

					<dt class="col-sm-5">Valid for</dt>
					<dd class="col-sm-7">@(Model.Duration is int days ? days + (days == 1 ? " day" : " days") : "Forever")</dd>

					@if (Model.ActiveClients > 0)
					{
						<dt class="col-sm-5">Clients holding this plan</dt>
						<dd class="col-sm-7 mb-0">@Model.ActiveClients</dd>
					}
				</dl>
			</div>
		</div>
	</div>
</div>
