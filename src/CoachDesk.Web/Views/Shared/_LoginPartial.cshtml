@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Http.Extensions
@using CoachDesk.Data.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Account" asp-action="Index">
        	Hello, <span style="text-transform: initial;">@((await UserManager.GetUserAsync(User))!.FullName)</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">Logout</a>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Context.Request.GetEncodedPathAndQuery()">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.GetEncodedPathAndQuery()">Login</a>
    </li>
}
</ul>
