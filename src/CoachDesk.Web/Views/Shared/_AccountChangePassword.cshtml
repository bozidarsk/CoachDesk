@model AccountChangePasswordInputModel

<form class="card mb-4" asp-controller="Account" asp-action="ChangePassword" method="post" id="password">
	<div class="card-header fw-bold">Password</div>
	<div class="card-body">
		<div class="mb-3">
			<label class="form-label" asp-for="CurrentPassword"></label>
			<input class="form-control" asp-for="CurrentPassword" autocomplete="current-password"/>
			<span asp-validation-for="CurrentPassword" class="text-danger"></span>
		</div>
		<div class="mb-3">
			<label class="form-label" asp-for="NewPassword"></label>
			<input class="form-control" asp-for="NewPassword" autocomplete="new-password"/>
			<span asp-validation-for="NewPassword" class="text-danger"></span>
		</div>
	</div>
	<div class="card-footer">
		<button class="btn btn-primary" type="submit">Change password</button>
	</div>
</form>
