@model MembershipPlanViewModel

<div class="form-floating mb-3">
	<input asp-for="Name" class="form-control" placeholder="For example: Monthly, 12 sessions" autofocus/>
	<label asp-for="Name" class="form-label"></label>
	<span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="form-floating mb-3">
	<input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder=""/>
	<label asp-for="Price" class="form-label"></label>
	<span asp-validation-for="Price" class="text-danger"></span>
</div>

<div class="row">
	<div class="form-floating col-sm-6 mb-3">
		<input asp-for="Count" class="form-control" type="number" min="1" step="1" placeholder=""/>
		<label asp-for="Count" class="form-label"></label>
		<div class="form-text">Leave empty for unlimited sessions.</div>
		<span asp-validation-for="Count" class="text-danger"></span>
	</div>

	<div class="form-floating col-sm-6 mb-3">
		<input asp-for="Duration" class="form-control" type="number" min="1" step="1" placeholder=""/>
		<label asp-for="Duration" class="form-label"></label>
		<div class="form-text">Leave empty if the plan never expires.</div>
		<span asp-validation-for="Duration" class="text-danger"></span>
	</div>
</div>
