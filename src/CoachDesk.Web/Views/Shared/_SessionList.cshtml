@model IEnumerable<SessionViewModel>
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Http.Extensions
@using Microsoft.AspNetCore.Identity
@using CoachDesk.Data.Models
@using static CoachDesk.Common.ApplicationConstants

@attribute [Authorize]

@inject UserManager<ApplicationUser> UserManager

@{
	var user = (await UserManager.GetUserAsync(User))!;
}

<ul class="list-group list-group-flush">
	@if (TempData["SessionCancelError"] is string sessionCancelError)
	{
		<span class="alert alert-danger m-3 mb-0">@sessionCancelError</span>
	}

	@foreach (var session in Model)
	{
		<li class="list-group-item d-flex flex-wrap align-items-center gap-2">
			<div class="me-auto">
				<div class="fw-bold">@session.Date.ToString("ddd, dd MMM yyyy")</div>
				<div class="text-muted small">
					@if (await UserManager.IsInRoleAsync(user, CoachRole))
					{
						<span>@session.Date.ToString("HH:mm") with @session.ClientFullName</span>
					}
					else if (await UserManager.IsInRoleAsync(user, ClientRole))
					{
						<span>@session.Date.ToString("HH:mm") with @session.CoachFullName</span>
					}
				</div>
			</div>
			@if (session.CanCancel)
			{
				<form asp-controller="Session" asp-action="Cancel" asp-route-id="@session.Id" method="post" onsubmit="return confirm('Cancel this session?');">
					<input type="hidden" name="returnUrl" value="@Context.Request.GetEncodedPathAndQuery()"/>
					<button class="btn btn-sm btn-outline-danger" type="submit">Cancel session</button>
				</form>
			}
		</li>
	}
</ul>
