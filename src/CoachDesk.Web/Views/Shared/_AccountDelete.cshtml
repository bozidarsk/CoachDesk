@model AccountDeleteInputModel

<form class="card border-danger mb-4" asp-controller="Account" asp-action="Delete" method="post" id="delete" onsubmit="return confirm('Delete your account for good? This cannot be undone.');">
	<div class="card-header fw-bold text-danger">Delete account</div>
	<div class="card-body">
		<p>This permanently deletes your login and your profile. It cannot be undone.</p>
		<div class="mb-3">
			<label class="form-label" asp-for="Password"></label>
			<input class="form-control" asp-for="Password" autocomplete="current-password"/>
			<span asp-validation-for="Password" class="text-danger"></span>
		</div>
		<div class="form-check">
			<input class="form-check-input" asp-for="Confirm"/>
			<label class="form-check-label" asp-for="Confirm">I understand that this cannot be undone</label>
			<div><span asp-validation-for="Confirm" class="text-danger"></span></div>
		</div>
	</div>
	<div class="card-footer">
		<button class="btn btn-danger" type="submit">Delete my account</button>
	</div>
</form>
