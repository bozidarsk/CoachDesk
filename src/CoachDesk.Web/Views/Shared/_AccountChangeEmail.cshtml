@model AccountChangeEmailInputModel

<form class="card mb-4" asp-controller="Account" asp-action="ChangeEmail" method="post" id="email">
	<div class="card-header fw-bold">Email</div>
	<div class="card-body">
		<p class="text-muted">
			Your email is also your login. It is currently <strong>@Model.CurrentEmail</strong>.
		</p>
		<div class="mb-3">
			<label class="form-label" asp-for="NewEmail"></label>
			<input class="form-control" asp-for="NewEmail" autocomplete="email"/>
			<span asp-validation-for="NewEmail" class="text-danger"></span>
		</div>
		<div>
			<label class="form-label" asp-for="EmailCurrentPassword"></label>
			<input class="form-control" asp-for="EmailCurrentPassword" autocomplete="current-password"/>
			<span asp-validation-for="EmailCurrentPassword" class="text-danger"></span>
		</div>
	</div>
	<div class="card-footer">
		<button class="btn btn-primary" type="submit">Change email</button>
	</div>
</form>
