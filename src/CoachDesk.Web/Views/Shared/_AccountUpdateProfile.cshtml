@model AccountUpdateProfileInputModel

<form class="card mb-4" asp-controller="Account" asp-action="UpdateProfile" method="post" id="profile">
	<div class="card-header fw-bold">Profile</div>
	<div class="card-body">
		<div class="mb-3">
			<label class="form-label" asp-for="FullName"></label>
			<input class="form-control" asp-for="FullName" autocomplete="name"/>
			<span asp-validation-for="FullName" class="text-danger"></span>
		</div>
		<div>
			<label class="form-label" asp-for="Bio"></label>
			<textarea class="form-control" asp-for="Bio" rows="4"></textarea>
			<div class="form-text">Shown on your public profile.</div>
			<span asp-validation-for="Bio" class="text-danger"></span>
		</div>
	</div>
	<div class="card-footer">
		<button class="btn btn-primary" type="submit">Save profile</button>
	</div>
</form>
