@model ErrorViewModel

@{
	ViewData["Title"] = $"{Model.Code} {Model.Name}";

	var tone = Model.Code >= 500 ? "danger" : "warning";
}

<div class="text-center py-5">
	<div class="display-1 fw-bold text-@(tone)">@Model.Code</div>
	<h1 class="h3 mb-3">@Model.Name</h1>
	<p class="text-muted">@Model.Message</p>
	<a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
	@if (Model.Code >= 500)
	{
		<p class="small text-muted mt-4">Request id: @Model.RequestId</p>
	}
</div>
